{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-verify.example/spec/v1/prompt_set.schema.json",
  "title": "封存题库",
  "description": "一次封存的题库版本：题目、意图类型、优先级、来源，以及封存人、封存时间和内容哈希。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_set_id",
    "project_id",
    "version",
    "previous_hash",
    "prompts",
    "preregistration_hash",
    "sealed_by",
    "sealed_at",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "prompt_set_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "text",
          "intent_type",
          "business_level",
          "priority",
          "source"
        ],
        "properties": {
          "query_id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "intent_type": {
            "$ref": "#/$defs/intent_type"
          },
          "business_level": {
            "enum": [
              "L1",
              "L2",
              "L3",
              null
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "source": {
            "$ref": "#/$defs/text"
          },
          "expects_recommendation": {
            "type": "boolean"
          },
          "core_fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "ext": {
            "type": "object"
          }
        }
      }
    },
    "preregistration_hash": {
      "$ref": "#/$defs/sha256"
    },
    "sealed_by": {
      "$ref": "#/$defs/text"
    },
    "sealed_at": {
      "$ref": "#/$defs/utc_time"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "synthetic": {
      "type": "boolean"
    },
    "ext": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "previous_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "intent_type": {
      "enum": [
        "brand",
        "product",
        "category",
        "scenario",
        "problem",
        "comparison",
        "decision",
        "after_sales",
        "risk",
        "competitor",
        "general"
      ]
    }
  }
}
