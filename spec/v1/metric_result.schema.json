{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-verify.example/spec/v1/metric_result.schema.json",
  "title": "指标结果",
  "description": "一个指标在一个范围内的结果：值、分子、分母、剔除数、区间、样本充分性、口径版本。分母为 0 时 value 为 null 并给出 null_reason。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metric_id",
    "project_id",
    "scope",
    "value",
    "null_reason",
    "numerator",
    "denominator",
    "excluded",
    "interval",
    "sufficiency",
    "definition_version",
    "preregistered",
    "role",
    "drilldown"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "metric_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "channel",
        "window_id",
        "date",
        "entity_id"
      ],
      "properties": {
        "platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel": {
          "anyOf": [
            {
              "$ref": "#/$defs/channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "window_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "null_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "numerator": {
      "type": [
        "number",
        "null"
      ]
    },
    "denominator": {
      "type": [
        "number",
        "null"
      ]
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "rules"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "count"
            ],
            "properties": {
              "rule": {
                "$ref": "#/$defs/text"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "interval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "level",
            "low",
            "high"
          ],
          "properties": {
            "method": {
              "enum": [
                "wilson",
                "cluster_bootstrap",
                "paired_cluster_bootstrap"
              ]
            },
            "level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "clustering": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clusters",
            "icc",
            "design_effect",
            "effective_n"
          ],
          "properties": {
            "clusters": {
              "type": "integer",
              "minimum": 0
            },
            "icc": {
              "type": [
                "number",
                "null"
              ]
            },
            "design_effect": {
              "type": [
                "number",
                "null"
              ]
            },
            "effective_n": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sufficient",
        "windows",
        "valid_observations",
        "reasons"
      ],
      "properties": {
        "sufficient": {
          "type": "boolean"
        },
        "windows": {
          "type": "integer",
          "minimum": 0
        },
        "valid_observations": {
          "type": "integer",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "definition_version": {
      "$ref": "#/$defs/text"
    },
    "preregistered": {
      "type": "boolean",
      "description": "false 表示事后指标，不能用于验收结论。"
    },
    "role": {
      "enum": [
        "acceptance",
        "descriptive",
        "post_hoc"
      ]
    },
    "components": {
      "type": "object"
    },
    "drilldown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "numerator_ids_hash",
        "denominator_ids_hash"
      ],
      "properties": {
        "unit": {
          "enum": [
            "observation",
            "query",
            "citation",
            "judgment",
            "fact",
            "window",
            "none"
          ]
        },
        "numerator_ids_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator_ids_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "numerator_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denominator_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "synthetic": {
      "type": "boolean"
    },
    "ext": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "value": {
            "type": "null"
          }
        },
        "required": [
          "value"
        ]
      },
      "then": {
        "properties": {
          "null_reason": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "null_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "preregistered": {
            "const": false
          }
        },
        "required": [
          "preregistered"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "post_hoc"
          }
        }
      },
      "else": {
        "properties": {
          "role": {
            "enum": [
              "acceptance",
              "descriptive"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "channel": {
      "enum": [
        "api",
        "manual",
        "share_import",
        "browser_assist",
        "file_import"
      ]
    }
  }
}
