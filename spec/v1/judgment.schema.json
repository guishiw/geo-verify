{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-verify.example/spec/v1/judgment.schema.json",
  "title": "判定",
  "description": "陈述与事实的判定。两个方向、两个分母：answer_to_facts 用于准确率，facts_to_answer 用于呈现率。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "judgment_id",
    "project_id",
    "direction",
    "source",
    "query_id",
    "claim_id",
    "fact_id",
    "fact_version",
    "label",
    "reason",
    "as_of",
    "judge",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "judgment_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "direction": {
      "enum": [
        "answer_to_facts",
        "facts_to_answer"
      ]
    },
    "source": {
      "$ref": "#/$defs/source_ref"
    },
    "query_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "fact_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "fact_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "label": {
      "enum": [
        "supported",
        "contradicted",
        "unverifiable",
        "present_correct",
        "present_wrong",
        "missing"
      ]
    },
    "claim_type": {
      "enum": [
        "numeric",
        "model",
        "date",
        "free_text",
        null
      ]
    },
    "reason": {
      "$ref": "#/$defs/text"
    },
    "as_of": {
      "$ref": "#/$defs/date"
    },
    "judge": {
      "$ref": "#/$defs/actor"
    },
    "created_at": {
      "$ref": "#/$defs/utc_time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "ext": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "direction": {
            "const": "answer_to_facts"
          }
        },
        "required": [
          "direction"
        ]
      },
      "then": {
        "properties": {
          "label": {
            "enum": [
              "supported",
              "contradicted",
              "unverifiable"
            ]
          },
          "claim_id": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "label": {
            "enum": [
              "present_correct",
              "present_wrong",
              "missing"
            ]
          },
          "fact_id": {
            "type": "string"
          },
          "fact_version": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "label": {
            "enum": [
              "supported",
              "contradicted"
            ]
          }
        },
        "required": [
          "label"
        ]
      },
      "then": {
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "fact_version": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "utc_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "enum": [
            "rule",
            "model",
            "human"
          ]
        },
        "id": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "observation",
            "draft"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
